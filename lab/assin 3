  SPLIT_PART(REJECTED_RECORD, ',', 5) AS CATEGORY,
  SPLIT_PART(REJECTED_RECORD, ',', 6) AS SUBCATEGORY
FROM OUR_FIRST_DB.PUBLIC.ORDERS_ERRORS
);

