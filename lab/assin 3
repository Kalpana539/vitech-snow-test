   CREATE OR REPLACE TABLE OUR_FIRST_DB.PUBLIC.ORDERS_v10 (
    ORDER_ID VARCHAR(30),
    AMOUNT INT,
    PROFIT INT,
    QUANTITY INT,
    CATEGORY VARCHAR(30),
    SUBCATEGORY VARCHAR(30));

 COPY INTO OUR_FIRST_DB.PUBLIC.ORDERS_v10  
 FROM @OUR_FIRST_DB.PUBLIC.orders_ext_stage 
 VALIDATION_mODE=RETURN_ERRORS;


 SELECT * FROM OUR_FIRST_DB.PUBLIC.ORDERS_v10 ;


